generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model Users {
  id            String        @id @default(uuid())
  publicId      String        @unique
  email         String        @unique
  passwordHash  String
  countryCode   String
  role          Role
  status        AccountStatus @default(ACTIVE)
  merchantId    String?
  failedLogins  Int           @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  passwordChangedAt DateTime  @default(now())
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  merchant   Merchants?  @relation(fields: [merchantId], references: [id])
  payments   Payments[]
  transactions Transactions[]
  resolutions Resolution[]
  sessions   Session[]
  loginAttempts LoginAttempt[]

  @@index([merchantId])
  @@index([createdAt])
}

// Refresh-token sessions give explicit revocation (no 7-day unrevocable bearer).
model Session {
  id               String    @id @default(uuid())
  publicId         String    @unique
  userId           String
  // Refresh tokens are looked up by digest, so this must be unique.
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  /// Token family. Every rotation inherits the original family, so presenting
  /// an already-rotated token identifies the whole family and revokes it. A
  /// stolen token replayed alongside the legitimate client would otherwise
  /// keep minting fresh sessions indefinitely.
  familyId         String?
  /// Set when this session was revoked because a rotated token was replayed.
  revokedReason    String?

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ip        String?
  succeeded Boolean
  createdAt DateTime @default(now())

  userId String?
  user   Users? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Machine credentials. `prefix` is the lookup key; `hash` is the only secret.
model ApiKey {
  id         String    @id @default(uuid())
  publicId   String    @unique
  merchantId String?
  name       String
  prefix     String    @unique
  // Only ever stored as a SHA-256 digest. Uniqueness here is what makes the
  // per-request lookup an indexed equality match instead of a table scan.
  hash       String    @unique
  scopes     String[]
  mode       KeyMode   @default(LIVE)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  merchant Merchants? @relation(fields: [merchantId], references: [id])

  @@index([merchantId, revokedAt])
}

// ---------------------------------------------------------------------------
// Merchant
// ---------------------------------------------------------------------------

model Merchants {
  id                    String        @id @default(uuid())
  publicId              String        @unique
  name                  String
  email                 String        @unique
  status                AccountStatus @default(PENDING_REVIEW)
  countryCode           String        @default("IN")
  // Which environment this merchant transacts in. TEST merchants accept test
  // card numbers and never move real money; LIVE merchants reject them.
  //
  // The payer is always a customer on a session JWT and carries no
  // environment, so the merchant is the only place this distinction can live.
  mode                  KeyMode       @default(TEST)
  settlementCurrency    String        @default("INR")
  settlementDelayDays   Int           @default(2)
  defaultFeeBasisPoints Int           @default(200)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  users         Users[]
  payments      Payments[]
  ledgers       Ledgers[]
  balances      MerchantBalance[]
  apiKeys       ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  payoutDestinations PayoutDestination[]
  payouts       Payout[]
  kyc           MerchantKyc?
  risk          MerchantRisk?
  providerAccount MerchantProviderAccount?
  feeSchedule   MerchantFeeSchedule?
  paymentMethods SavedPaymentMethod[]

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Compliance
//
// Accepting a merchant in PayForge is not the same as being accepted by a bank
// or payment provider. These models record the *external* party's view
// separately, so enabling live mode requires both systems to agree rather than
// trusting PayForge's own approval alone.
// ---------------------------------------------------------------------------

model MerchantRisk {
  id                 String    @id @default(uuid())
  merchantId         String    @unique
  /// 0–100. Bands are policy, not a regulatory definition.
  riskScore          Int       @default(0)
  sanctionsChecked   Boolean   @default(false)
  sanctionsCheckedAt DateTime?
  pepChecked         Boolean   @default(false)
  pepCheckedAt       DateTime?
  /// Rolling chargeback rate as a fraction (0.05 = 5%).
  chargebackRate     Float     @default(0)
  chargebackUpdatedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  merchant Merchants @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

/// The provider's own onboarding and activation state for this merchant.
model MerchantProviderAccount {
  id               String              @id @default(uuid())
  publicId         String              @unique
  merchantId       String              @unique
  /// Adapter identifier, e.g. 'stripe', 'razorpay'. Must match the wired
  /// BankPort implementation so an operator can tell which system is which.
  provider         String
  /// The provider's account reference, e.g. Stripe's acct_…
  providerAccountId String?
  onboardingStatus ProviderOnboarding  @default(NOT_STARTED)
  /// The provider will only capture funds when these are true. Recording them
  /// is what stops PayForge taking money for a merchant the PSP has actually
  /// restricted — the two systems routinely disagree.
  chargesEnabled   Boolean             @default(false)
  payoutsEnabled   Boolean             @default(false)
  requirementsDue  String?
  lastSyncedAt     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  merchant Merchants @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([provider, onboardingStatus])
}

enum ProviderOnboarding {
  NOT_STARTED
  PENDING
  /// Onboarded, but the provider is still holding funds or restricting them.
  RESTRICTED
  ENABLED
  DISABLED
}

model MerchantKyc {
  id                 String    @id @default(uuid())
  merchantId         String    @unique
  legalName          String?
  registrationNumber String?
  taxId              String?
  countryCode        String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  postalCode         String?
  status             KycStatus @default(NOT_STARTED)
  rejectionReason    String?
  /// Admin-facing review notes. Distinct from `rejectionReason`, which the
  /// merchant sees: this is the auditor's reasoning, retained for dispute.
  reviewNotes        String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  merchant Merchants @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantFeeSchedule {
  id            String   @id @default(uuid())
  merchantId    String   @unique
  basisPoints   Int
  minFeeMinor   BigInt   @default(0)
  maxFeeMinor   BigInt?
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  merchant Merchants @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MerchantBalance {
  id         String   @id @default(uuid())
  merchantId String
  currency   String
  balance    BigInt   @default(0)
  pending    BigInt   @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  merchant Merchants @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, currency])
}

model PlatformAccount {
  id        String   @id @default(uuid())
  currency  String   @unique
  balance   BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExchangeRateSnapshot {
  id        String   @id @default(uuid())
  rateDate  DateTime @unique @db.Date
  baseCode  String
  rates     Json
  fetchedAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Money movement
// ---------------------------------------------------------------------------

model Payments {
  id                 String        @id @default(uuid())
  publicId           String        @unique
  userId             String
  merchantId         String
  amount             BigInt
  currency           String
  fxRateDate         DateTime      @db.Date
  usdRate            Decimal       @db.Decimal(24, 10)
  inrRate            Decimal       @db.Decimal(24, 10)
  settlementAmount   BigInt
  settlementCurrency String
  feeBasisPoints     Int           @default(200)
  status             PaymentStatus
  idempotencyKey     String?
  refundedAmount     BigInt        @default(0)
  expiresAt          DateTime
  description        String?
  metadata           Json?
  cancelledReason    String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user         Users          @relation(fields: [userId], references: [id])
  merchant     Merchants      @relation(fields: [merchantId], references: [id])
  transactions Transactions[]
  refunds      Refund[]
  clientSessions ClientSession[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([merchantId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model Transactions {
  id             String            @id @default(uuid())
  publicId       String            @unique
  userId         String
  paymentId      String
  method         PaymentMethod
  status         TransactionStatus
  gatewayRef     String            @unique
  idempotencyKey String
  payloadHash    String
  currency       String
  amount         BigInt
  fee            BigInt            @default(0)
  netAmount      BigInt            @default(0)
  failureCode    String?
  failureMessage String?
  settledAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user             Users              @relation(fields: [userId], references: [id])
  payment          Payments           @relation(fields: [paymentId], references: [id])
  cardDetail       CardDetails?
  upiDetail        UpiDetails?
  netBankingDetail NetBankingDetails?
  walletDetail     WalletDetails?
  refunds          Refund[]

  @@unique([userId, idempotencyKey])
  @@index([paymentId])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Append-only money journal. Exactly two rows per movement (MERCHANT + PLATFORM).
model Ledgers {
  id          String         @id @default(uuid())
  publicId    String         @unique
  account     LedgerAccount
  accountKey  String
  merchantId  String?
  currency    String
  amount      BigInt
  type        LedgerType
  referenceId String
  balanceAfter BigInt?
  createdAt   DateTime       @default(now())

  merchant Merchants? @relation(fields: [merchantId], references: [id])

  @@unique([account, accountKey, referenceId, type])
  @@index([account, currency, createdAt])
  @@index([merchantId, createdAt])
  @@index([referenceId])
}

model Refund {
  id             String       @id @default(uuid())
  publicId       String       @unique
  paymentId      String
  transactionId  String
  merchantId     String
  amount         BigInt
  currency       String
  feeReversed    BigInt       @default(0)
  netReversed    BigInt       @default(0)
  reason         String?
  /// PENDING is reserved before the provider is called, because a bank refund
  /// is irreversible: once the money has gone back to the cardholder there is
  /// nothing to compensate with. A row still PENDING when the sweeper runs is
  /// either in flight or was stranded by a crash, and is resolved by
  /// ReconciliationService against the provider.
  status         RefundStatus @default(PENDING)
  /// The provider's refund reference. Recorded so a stranded PENDING refund can
  /// be resolved by querying the bank rather than re-sending the money.
  gatewayRefundRef String?
  failureReason  String?
  idempotencyKey String
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payment     Payments    @relation(fields: [paymentId], references: [id])
  transaction Transactions @relation(fields: [transactionId], references: [id])

  @@unique([merchantId, idempotencyKey])
  @@index([paymentId, createdAt])
  @@index([merchantId, createdAt])
  @@index([status, createdAt])
}

model PayoutDestination {
  id            String            @id @default(uuid())
  publicId      String            @unique
  merchantId    String
  bankName      String
  accountHolder String
  accountLast4  String
  accountEnc    String
  routingEnc    String
  currency      String
  status        DestinationStatus @default(ACTIVE)
  isDefault     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  merchant Merchants @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payouts  Payout[]

  @@index([merchantId, status])
}

model Payout {
  id             String       @id @default(uuid())
  publicId       String       @unique
  merchantId     String
  destinationId  String?
  amount         BigInt
  currency       String
  status         PayoutStatus @default(SCHEDULED)
  externalRef    String?
  failureReason  String?
  idempotencyKey String
  requestedById  String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  merchant    Merchants          @relation(fields: [merchantId], references: [id])
  destination PayoutDestination? @relation(fields: [destinationId], references: [id])

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Tokenization (PCI: PAN never reaches PayForge in the hosted-fields flow)
// ---------------------------------------------------------------------------

model ClientSession {
  id               String    @id @default(uuid())
  publicId         String    @unique
  secretHash       String    @unique
  paymentId        String?
  merchantId       String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime  @default(now())

  payment Payments? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([merchantId, expiresAt])
}

model SavedPaymentMethod {
  id           String        @id @default(uuid())
  publicId     String        @unique
  merchantId   String
  customerRef  String?
  type         PaymentMethod @default(CARD)
  gatewayToken String        @unique
  brand        CardBrand?
  last4        String?
  expiryMonth  Int?
  expiryYear   Int?
  holderName   String?
  status       SavedMethodStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  merchant Merchants @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, status])
  @@index([merchantId, customerRef])
}

// ---------------------------------------------------------------------------
// Outbound webhooks
// ---------------------------------------------------------------------------

model WebhookEndpoint {
  id          String                @id @default(uuid())
  publicId    String                @unique
  merchantId  String
  url         String
  secretEnc   String
  events      String[]
  status      WebhookEndpointStatus @default(ACTIVE)
  description String?
  failureCount Int                  @default(0)
  disabledReason String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  merchant   Merchants        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([merchantId, status])
}

model WebhookDelivery {
  id             String           @id @default(uuid())
  publicId       String           @unique
  endpointId     String
  eventId        String
  eventType      WebhookEventType
  payload        Json
  status         DeliveryStatus   @default(PENDING)
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model Resolution {
  id              String              @id @default(uuid())
  publicId        String              @unique
  /// Nullable for SYSTEM actors: a scheduled job or an inbound provider
  /// callback has no user behind it. The foreign key still applies whenever
  /// actorType is USER or API_KEY.
  actorId         String?
  actorType       ActorType           @default(USER)
  action          ResolutionAction
  subjectType     ResolutionSubject
  subjectPublicId String
  metadata        Json?
  createdAt       DateTime            @default(now())

  actor Users? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([subjectPublicId, createdAt])
}

// ---------------------------------------------------------------------------
// Payment method detail (1:1 extension of Transactions)
// ---------------------------------------------------------------------------

model CardDetails {
  id            String   @id @default(uuid())
  transactionId String   @unique
  holderName    String
  brand         CardBrand
  last4         String
  expiryMonth   Int
  expiryYear    Int
  avsResult     String?
  cvvResult     String?

  transaction Transactions @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model UpiDetails {
  id            String @id @default(uuid())
  transactionId String @unique
  vpa           String

  transaction Transactions @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model NetBankingDetails {
  id            String @id @default(uuid())
  transactionId String @unique
  bankCode      String

  transaction Transactions @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model WalletDetails {
  id            String         @id @default(uuid())
  transactionId String         @unique
  provider      WalletProvider

  transaction Transactions @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  MERCHANT
  SUPER_ADMIN
}

enum ActorType {
  USER
  API_KEY
  SYSTEM
}

enum AccountStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  NOT_STARTED
  SUBMITTED
  APPROVED
  REJECTED
}

enum KeyMode {
  LIVE
  TEST
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  EXPIRED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  VOIDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum PayoutStatus {
  SCHEDULED
  IN_TRANSIT
  PAID
  FAILED
  REVERSED
}

enum DestinationStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum LedgerType {
  CREDIT
  DEBIT
}

enum LedgerAccount {
  MERCHANT
  PLATFORM
  /// Counterparty for money leaving the platform: settles what the merchant
  /// earns against a captured charge, and is debited by outbound payouts.
  /// Without it every movement posts a single unpaired leg and the journal
  /// cannot be shown to balance.
  MERCHANT_CLEARING
  /// Funds captured at the provider but not yet swept to a merchant balance.
  PSP_CLEARING
}

enum ResolutionAction {
  SUSPEND_MERCHANT
  RESTORE_MERCHANT
  APPROVE_MERCHANT
  SUSPEND_USER
  RESTORE_USER
  REFUND
  CREATE_API_KEY
  REVOKE_API_KEY
  PAYOUT_CREATED
  /// A provider settled a charge whose payment had already been cancelled.
  /// The funds were captured regardless, so the ledger is posted and the
  /// payment is returned to SUCCESS for the merchant to see and refund if
  /// they choose. Recorded so the event is auditable rather than a bare log.
  SETTLE_CANCELLED_PAYMENT
  KYC_APPROVED
  KYC_REJECTED
  /// Reconciliation found a discrepancy between the journal and balances.
  RECONCILIATION_BREAK
  /// A merchant was moved between TEST and LIVE.
  SET_MERCHANT_MODE
  /// Risk and sanctions/PEP screening state was recorded.
  SET_MERCHANT_RISK
  /// The payment provider's onboarding and activation state was recorded.
  SET_PROVIDER_ACCOUNT
  /// Session-family revocation triggered by a replayed refresh token.
  SESSION_REVOKED_REUSE
  /// A user changed their password; all other sessions were revoked.
  PASSWORD_CHANGED
}

enum ResolutionSubject {
  USER
  MERCHANT
  PAYMENT
  API_KEY
  PAYOUT
}

enum PaymentMethod {
  CARD
  UPI
  NET_BANKING
  WALLET
}

enum SavedMethodStatus {
  ACTIVE
  DISABLED
}

enum CardBrand {
  VISA
  MASTERCARD
  RUPAY
  AMEX
  DISCOVER
  DINERS_CLUB
  JCB
  UNIONPAY
  MAESTRO
  OTHER
}

enum WalletProvider {
  PAYTM
  PHONEPE
  AMAZON_PAY
  MOBIKWIK
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookEventType {
  PAYMENT_CREATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_CANCELLED
  PAYMENT_EXPIRED
  PAYMENT_REFUNDED
  REFUND_SUCCEEDED
  REFUND_FAILED
  /// A payout was accepted for scheduling. Distinct from PAYOUT_PAID: no
  /// money has left the platform at this point.
  PAYOUT_SCHEDULED
  PAYOUT_PAID
  PAYOUT_FAILED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}