# ---------------------------------------------------------------------------
# PayForge server configuration
#
# Copy to `.env` and fill in. Generate secrets with: openssl rand -hex 32
# Never commit the real .env — it is ignored by .gitignore (all .env* variants).
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Pooled connection for runtime traffic.
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"
# Direct connection, used for migrations. Must bypass the pooler.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Secrets ----------------------------------------------------------------
# Minimum 32 characters each; the server refuses to boot otherwise.
# JWT_SECRET                signs session access tokens
# ENCRYPTION_KEY           encrypts payout bank details at rest
# WEBHOOK_SIGNING_KEY       envelope key protecting per-endpoint webhook secrets
# BANK_WEBHOOK_SECRET       verifies inbound bank callbacks
JWT_SECRET=""
ENCRYPTION_KEY=""
WEBHOOK_SIGNING_KEY=""
BANK_WEBHOOK_SECRET=""

# --- Bootstrap admin --------------------------------------------------------
# Created on first boot if absent. Minimum 12 characters.
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD=""

# --- Third-party ------------------------------------------------------------
# exchangerate-api.com v6 key. Swap FX_PROVIDER_URL for a different vendor.
EXCHANGE_RATE_API_KEY=""
FX_PROVIDER_URL="https://v6.exchangerate-api.com/v6"

# --- Server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated explicit origins. "*" is rejected at boot.
CORS_ORIGINS="http://localhost:3001"

# Mount Swagger UI at /docs. Forced off when NODE_ENV=production.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Development-only helpers
# ---------------------------------------------------------------------------

# Opt-in, not opt-out. The original gate was `NODE_ENV === 'production'`, but
# nothing in the repo set NODE_ENV, so the safe state was never the default.
# With this off, POST /v1/dev/bank/settle does not exist.
ENABLE_DEV_TOOLS=false

# ---------------------------------------------------------------------------
# Rate limits (requests per minute, per IP)
# Raise only if you have a specific reason — a NAT'd office egress, or CI.
# ---------------------------------------------------------------------------
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=30
RATE_LIMIT_BANK=600

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Override the platform default fee, in basis points (200 = 2.00%).
PLATFORM_FEE_BASIS_POINTS=200

# Payout adapter name. Only "mock" ships today.
PAYOUT_ADAPTER=mock